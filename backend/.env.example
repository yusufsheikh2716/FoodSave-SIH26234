# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://foodsave:foodsave_dev@localhost:5432/foodsave

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production

# ── ML Microservice ──────────────────────────────────────
# NEVER hardcode localhost in source code — set this per environment
ML_SERVICE_URL=http://localhost:8000

# ── Frontend Origin (for CORS) ───────────────────────────
# Set to your deployed frontend domain in production
FRONTEND_ORIGIN=http://localhost:3000

# ── ESG Constants ────────────────────────────────────────
# IPCC/FAO-aligned: kg CO2e avoided per kg food rescued
CO2_FACTOR_KG_PER_KG=2.5

# ── Server ───────────────────────────────────────────────
PORT=4000
